# Copy to secrets.auto.tfvars (gitignored) and fill in. Never commit the copy.
#
# Prod's own Google OAuth client. Its authorised redirect URI must be
#   https://auth-prod.tharunsekar.xyz/oauth2/idpresponse
google_client_id     = "your-prod-google-oauth-client-id.apps.googleusercontent.com"
google_client_secret = "your-prod-google-oauth-client-secret"

alert_emails = ["you@example.com"]
